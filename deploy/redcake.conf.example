# RedCake configuration file. Same options as the command line, without the leading "--".
# Command-line options override this file.  Secrets do NOT belong here: use REDCAKE_API_KEY,
# --api-key-file and the *-password-file options.

port 6379
bind 0.0.0.0
max-clients 10000
timeout 300

# Persistence
aof-file /var/lib/redcake/redcake.aof
aof-fsync everysec

# Memory
maxmemory 1gb
maxmemory-policy allkeys-random

# Security
acl-file /etc/redcake/users.acl
tls-keystore /etc/redcake/server.p12
tls-keystore-password-file /etc/redcake/keystore.pass

# Observability
metrics-port 9100
slowlog-threshold-us 10000

# Replication (uncomment on a replica)
# replicaof 10.0.0.5 6379
# tls-replication yes
repl-backlog-size 16mb

# Automatic failover with ZooKeeper (every node gets the same file except node-id/advertise-host).
# Excludes "replicaof": ZooKeeper decides which node is the primary. See docs/adr/0005-zookeeper-failover.md.
# zk-connect zk1:2181,zk2:2181,zk3:2181
# cluster-name redcake
# advertise-host node1.example.com
# node-id node1
# replica-priority 100
# zk-session-timeout-ms 10000
# cluster-election-delay-ms 1000
# min-replicas-to-write 1
# ZooKeeper credentials (user:password) belong in REDCAKE_ZK_AUTH or --zk-auth-file, not in this file.
